# ==============================================================================
# Honeywell Root Environment Example File
# Copy this file to .env and configure real credentials for your local development.
# ==============================================================================

# Database Configuration (Docker / Local MySQL)
DB_HOST=host.docker.internal
MYSQL_DATABASE=honeywell_products
MYSQL_USER=honeywelluser
MYSQL_PASSWORD=your_mysql_password_here

# Cashfree Sandbox Gateway Configuration (Backend)
CASHFREE_APP_ID=your_cashfree_sandbox_app_id
CASHFREE_SECRET_KEY=your_cashfree_sandbox_secret_key
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
CASHFREE_RETURN_URL=http://localhost:5173/order-success?order_id={order_id}
# Note: notify_url must be a public HTTPS endpoint (e.g. ngrok). Localhost URLs are automatically omitted.
CASHFREE_NOTIFY_URL=https://drab-smoking-unstaffed.ngrok-free.dev/api/Payment/cashfree-webhook
