# ==============================================================================
# Honeywell Backend Environment Configuration Example
# Set these environment variables in your local environment, Docker, or launchSettings.json
# ==============================================================================

# Cashfree Sandbox Gateway Credentials
# Retrieve App ID and Secret Key from Cashfree Sandbox Merchant Dashboard (Developers > API Keys)
CASHFREE_APP_ID=TEST_APP_ID_FROM_CASHFREE_MERCHANT_DASHBOARD
CASHFREE_SECRET_KEY=TEST_SECRET_KEY_FROM_CASHFREE_MERCHANT_DASHBOARD

# Exclusively locked to sandbox
CASHFREE_ENV=sandbox

# Official Cashfree API Version
CASHFREE_API_VERSION=2026-01-01

# Default Return URL pattern for client redirects
CASHFREE_RETURN_URL=http://localhost:5173/order-success?order_id={order_id}

# Cashfree Webhook Notification URL
# IMPORTANT: Cashfree requires a public HTTPS URL. Localhost URLs are automatically omitted.
CASHFREE_NOTIFY_URL=https://drab-smoking-unstaffed.ngrok-free.dev/api/Payment/cashfree-webhook
